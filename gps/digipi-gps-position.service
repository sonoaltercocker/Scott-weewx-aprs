# /etc/systemd/system/digipi-gps-position.service
# Version 1.6  -  Scott Sheppard, KJ4ZZB
# Checks the GPS at boot, then keeps watching and updates DigiPi's position
# once the station has settled at a new place.
# Type=simple so a slow or missing GPS fix never holds up the rest of boot.

[Unit]
Description=DigiPi - keep station position in step with the GPS
Wants=gpsd.service
After=gpsd.service gpsd.socket network.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/bin/digipi-gps-position.py --watch
Restart=on-failure
RestartSec=60

[Install]
WantedBy=multi-user.target
